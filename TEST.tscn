[sub_resource type="GDScript" id="GDScript_cd2k1"]
resource_name = "Inventory Wheel Holder"
script/source = "extends Node3D

@onready var player: Player2 = $\"..\"
@export var lag_strength: float = 0.03
@export var lag_smoothing: float = 2.0

var base_position: Vector3
var current_offset := Vector3.ZERO

func _ready() -> void:
	base_position = position

func _process(delta: float) -> void:
	var target_offset = -player.destination_velocity * lag_strength
	current_offset = current_offset.lerp(target_offset, delta * lag_smoothing)
	position = base_position + current_offset
"

