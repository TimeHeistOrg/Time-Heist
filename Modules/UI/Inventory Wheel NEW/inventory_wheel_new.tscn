[sub_resource type="GDScript" id="GDScript_6up7b"]
resource_name = "WheelSlotIcons"
script/source = "# slot_icons.gd 
@tool
extends Node2D

var sprites: Array[Sprite2D] = []

func setup() -> void:
	for s in sprites:
		s.queue_free()
	sprites.clear()
	
	var iw = get_parent() as Node2D
	var total = iw.num_of_items + 2
	
	for i in range(total):
		var sprite = Sprite2D.new()
		sprite.centered = true
		var icon_size = iw.width * 0.4
		sprite.scale = Vector2(icon_size / 64.0, icon_size / 64.0)
		add_child(sprite)
		sprites.append(sprite)

func update_icons(window: Array, wheel_rotation: float) -> void:
	var iw = get_parent() as Node2D
	
	if window.is_empty():
		for s in sprites:
			s.visible = false
		return
	
	if sprites.size() != iw.num_of_items + 2:
		setup()

	var target_size = iw.width * 0.4  # how big you want the icon in pixels
	var total = sprites.size()
	var step = iw.angle / iw.num_of_items
	var start_rad = -TAU / 4 - deg_to_rad(iw.angle / 2)
	var mid_r = iw.radius

	for i in range(total):
		var sprite = sprites[i]
		
		if i >= window.size():
			sprite.visible = false
			continue
		
		sprite.visible = true
		var item = window[i]
		var is_ghost = (i == 0 or i == total - 1)

		var slice_mid = start_rad + deg_to_rad(step * i + step / 2.0) + wheel_rotation
		sprite.position = Vector2.from_angle(slice_mid) * mid_r + iw.center
		sprite.modulate.a = 0.0 if is_ghost else 1.0

		if item and item.get(\"image\") and item.image:
			sprite.texture = item.image
			# scale to fit target_size regardless of source resolution
			var tex_size = item.image.get_size()
			var longest = max(tex_size.x, tex_size.y)
			sprite.scale = Vector2.ONE * (target_size / longest)
		else:
			sprite.texture = null
"

[sub_resource type="GDScript" id="GDScript_x46q2"]
resource_name = "DrawChosenSlot"
script/source = "@tool
extends Node2D

func draw_inven_selected():
	queue_redraw()
	
func _draw() -> void:
	var iw = self.owner as Node2D
	var slice_length = deg_to_rad(iw.angle/ iw.num_of_items)
	var start_of_arc = (-TAU / 4 - deg_to_rad(iw.angle / 2)) + ((iw.num_of_items/2)*slice_length)
	draw_arc(iw.center,iw.radius, start_of_arc, start_of_arc + slice_length,100,iw.selected_color,iw.width*1.2,false)
"

[sub_resource type="GDScript" id="GDScript_cmedq"]
resource_name = "ArcDraw"
script/source = "@tool
extends Node2D

func draw_inven_arc():
	queue_redraw()
	
func _draw() -> void:
	var iw = self.owner as Node2D
	draw_arc(iw.center,iw.wheel_radius,iw.end - iw.slots.size()*iw.full_slot_width,iw.end,100,iw.wheel_color,iw.wheel_width,false)
"

[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_psyux"]
blend_mode = 2

[sub_resource type="GDScript" id="GDScript_dqc0u"]
resource_name = "MaskDraw"
script/source = "@tool
extends Node2D

func draw_inven_line():
	queue_redraw()

func _ready() -> void:
	var mat = CanvasItemMaterial.new()
	mat.blend_mode = CanvasItemMaterial.BLEND_MODE_SUB
	material = mat

func _draw() -> void:
	var iw = self.owner as Node2D
	if iw:
		var step = iw.slot_width + (0.5*iw.slot_gap_width)
		
		for i in range(iw.slots.size()):
			var rads = iw.end + deg_to_rad(step * i)
			var point = Vector2.from_angle(rads)
			draw_line(
				point * (iw.wheel_radius - iw.wheel_width / 2) + iw.center,
				point * (iw.wheel_radius + iw.wheel_width / 2) + iw.center,
				Color(0.997, 0.812, 0.892, 1.0),
				iw.slot_gap_width,
				true
			)
			
"

[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_oturb"]
blend_mode = 2

[sub_resource type="GDScript" id="GDScript_5eme7"]
resource_name = "MaskBottomDraw"
script/source = "@tool
extends Node2D

func draw_inven_mask():
	queue_redraw()

func _ready() -> void:
	var mat = CanvasItemMaterial.new()
	mat.blend_mode = CanvasItemMaterial.BLEND_MODE_SUB
	material = mat

func _draw() -> void:
	var iw = get_parent() as Node2D
	# bottom mask
	var p_inner_start = Vector2.from_angle(iw.angle_start_rad) * (iw.radius - iw.width / 2.0) + iw.center
	var p_outer_start = Vector2.from_angle(iw.angle_start_rad) * (iw.radius + iw.width / 2.0) + iw.center
	var p_inner_end   = Vector2.from_angle(iw.angle_end_rad)   * (iw.radius - iw.width / 2.0) + iw.center
	var p_outer_end   = Vector2.from_angle(iw.angle_end_rad)   * (iw.radius + iw.width / 2.0) + iw.center

	var far_down = iw.center.y + iw.radius + 200.0
	var far_left = iw.center.x - iw.radius - 200.0
	var far_right = iw.center.x + iw.radius + 200.0

	draw_colored_polygon(PackedVector2Array([
		p_outer_start,
		p_inner_start,
		p_inner_end,
		p_outer_end,
		Vector2(far_right, p_outer_end.y),
		Vector2(far_right, far_down),
		Vector2(far_left,  far_down),
		Vector2(far_left,  p_outer_start.y),
	]), Color.WHITE)
"

